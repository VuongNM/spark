{
  "name": "spark",
  "productName": "Spark",
  "version": "0.1.0",
  "description": "Voice typing for Vietnamese developers: hold fn, talk, let go to paste.",
  "author": "Vuong Nguyen",
  "license": "MIT",
  "homepage": "https://vuongnm.github.io/spark/",
  "repository": {
    "type": "git",
    "url": "https://github.com/VuongNM/spark.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package:mac": "electron-vite build && electron-builder --mac && bash scripts/sign-mac.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:native": "mkdir -p resources/bin && xcrun swiftc -O -target arm64-apple-macos12 native/fn-watcher.swift -o /tmp/fnw-arm64 && xcrun swiftc -O -target x86_64-apple-macos12 native/fn-watcher.swift -o /tmp/fnw-x64 && lipo -create /tmp/fnw-arm64 /tmp/fnw-x64 -output resources/bin/fn-watcher"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "node-llama-cpp": "^3.22.2",
    "sherpa-onnx-node": "^1.13.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "uiohook-napi@1.5.5": true
  }
}
